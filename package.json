{
  "name": "grapi-project",
  "version": "3.0.0",
  "workspaces": [
    "grapi",
    "grapi-mongodb"
  ],
  "scripts": {
    "compile": "npx tsc --build tsconfig.build.json",
    "clean": "lerna run clean --stream --parallel",
    "build": "lerna run build --stream",
    "lint": "npx eslint --ext .ts .",
    "test": "lerna run test --stream --scope @grapi/server -- --colors",
    "test:scope": "lerna run test --stream --parallel --scope $SCOPE -- --colors",
    "postinstall": "npm run compile"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/chai-subset": "^1.3.6",
    "@types/faker": "^5.1.7",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
    "chai-subset": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "faker": "^5.5.3",
    "lerna": "^8.1.9",
    "mocha": "^10.7.0",
    "nyc": "^17.1.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "license": "ISC",
  "private": true,
  "dependencies": {}
}
