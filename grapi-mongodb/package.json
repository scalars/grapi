{
  "name": "@grapi/mongodb",
  "version": "3.0.8",
  "description": "The mongodb package of Grapi",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "jsnext:main": "./lib/index.js",
  "typings": "./lib/index.d.ts",
  "keywords": [
    "grapi",
    "scalars",
    "graphql",
    "mongo",
    "queries",
    "mongodb",
    "graphql-server",
    "graphql-schema",
    "mutations",
    "graphql-js"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "npx rimraf lib && npx rimraf tsconfig.release.tsbuildinfo",
    "build": "npm run clean && npx tsc --build ./tsconfig.release.json",
    "test": "npx mocha --timeout 100000 --require ts-node/register --recursive --exit \"test/**/*.spec.ts\"",
    "test:grep": "npx run mocha --compilers ts:ts-node/register --recursive",
    "coverage": "npx run nyc && npm run test",
    "watch": "npm run build -- --watch",
    "watch:test": "npm run test -- --watch",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": "https://github.com/scalars/grapi",
  "author": "madrov",
  "license": "Apache-2.0",
  "dependencies": {
    "@grapi/server": "^3.0.7",
    "mongodb": "^6.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {}
}
