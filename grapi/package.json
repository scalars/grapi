{
  "name": "@grapi/server",
  "version": "3.0.7",
  "description": "Grapi Schema Generator For GraphQL Server",
  "keywords": [
    "grapi",
    "scalars",
    "graphql",
    "mongo",
    "queries",
    "mongodb",
    "graphql-server",
    "graphql-schema",
    "mutations",
    "graphql-js"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "jsnext:main": "./lib/index.js",
  "typings": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "npx rimraf lib && npx rimraf tsconfig.release.tsbuildinfo",
    "build": "npm run clean && npx tsc --build ./tsconfig.release.json",
    "test": "npx mocha --timeout 100000 --require ts-node/register --recursive --exit \"test/**/*.spec.ts\"",
    "test:grep": "npx mocha --compilers ts:ts-node/register --recursive --exit",
    "test:run": "npx ts-node --project ../tsconfig.json test/testing.ts",
    "coverage": "npx nyc && npm run test",
    "watch": "npm run build -- --watch",
    "watch:test": "npm run test -- --watch",
    "prepublishOnly": "cp ../readme.md . && npm run clean && npm run build",
    "postpublish": "npx rimraf readme.md"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.34",
    "@graphql-tools/utils": "^11.1.0",
    "chalk": "^5.4.1",
    "graphql": "^16.14.0",
    "lodash": "^4.17.21",
    "pluralize": "^8.0.0",
    "validator": "^13.15.15"
  },
  "author": "madrov",
  "license": "ISC",
  "devDependencies": {
    "@apollo/server": "^5.5.0",
    "rimraf": "^4.4.1"
  },
  "peerDependencies": {
    "graphql": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/scalars/grapi",
  "private": false
}
